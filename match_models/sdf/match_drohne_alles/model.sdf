            <radius>0.05</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name='top_lidar' type='gpu_lidar'>
        <pose>0 0 0 0 0 0</pose>
        <topic>/match_drohne_alles/top_lidar/points</topic>
