<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="mid_360">
    <link name="link">
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>5e-5</ixx>
          <iyy>5e-5</iyy>
          <izz>5e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <sensor name="RGL_Lidar_MID360" type="custom" gz:type="rgl_lidar">
        <visualize>true</visualize>
        <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
          <range>
            <min>0.5</min>
            <max>100</max>
          </range>
          <update_rate>10</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>rgl_lidar</topic>
          <frame>RGLLidar</frame>
          <pattern_preset>Livox Mid360</pattern_preset>
        </plugin>
      </sensor>
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <visualize>true</visualize>
        <topic>rgl_lidar/imu</topic>
      </sensor>
    </link>

    <frame name="RGLLidar" attached_to="link">
      <pose>0 0 0 0 0 0</pose>
    </frame>

  </model>
</sdf>