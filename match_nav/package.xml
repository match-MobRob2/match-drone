<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>match_nav</name>
  <version>0.0.0</version>
  <description>3D Navigation Stack for Match Drone with Octomap, OMPL Path Planning and Autonomous Exploration</description>
  <maintainer email="luca0204@freenet.de">luca</maintainer>
  <license>MIT</license>

  <!-- Core ROS2 -->
  <depend>rclpy</depend>

  <!-- Custom Messages (match_nav_msgs package) -->
  <depend>match_nav_msgs</depend>

  <!-- Messages -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>

  <!-- SLAM Integration -->
  <depend>octomap_msgs</depend>

  <!-- Drone Control -->
  <depend>mavros_msgs</depend>

  <!-- TF -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
