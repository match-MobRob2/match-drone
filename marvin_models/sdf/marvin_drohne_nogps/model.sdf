<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>

  <model name='marvin_drohne_alles'>
    <self_collide>false</self_collide>
    <static>false</static>

    <include merge='true'>
      <uri>model://marvin_drohne</uri>
    </include>

    <include merge='true'>
      <pose relative_to="base_link">0.1 0 0.07 0 0.52 0</pose>
      <uri>model://mid_360</uri>
    </include>

    <joint name="realsense_joint" type="fixed">
      <parent>base_link</parent>
      <child>realsense_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <joint name="mid_360_joint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <include merge='true'>
      <pose relative_to="base_link">0.1 0 -0.08 0 0.2 0</pose>
      <child>realsense_link</child>
      <uri>model://intel_realsense</uri>
    </include>


