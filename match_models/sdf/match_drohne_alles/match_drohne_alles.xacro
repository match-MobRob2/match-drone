<?xml version="1.0"?>
<robot name="match_drohne_alles" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="front_sensor_offset_x" value="0.23"/>
  <xacro:property name="front_sensor_offset_y" value="0.0"/>
  <xacro:property name="front_sensor_offset_z" value="0.08"/>
  <xacro:property name="lidar_offset_x" value="0.0"/>
  <xacro:property name="lidar_offset_y" value="0.0"/>
  <xacro:property name="lidar_offset_z" value="0.20"/>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
  </link>

  <link name="front_sensor_mount_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="front_sensor_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_sensor_mount_link"/>
    <origin xyz="0.10 0 -0.1069" rpy="0 0.2 0"/>
  </joint>

  <link name="front_rgb_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="camera_grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>


  <joint name="front_rgb_camera_joint" type="fixed">
    <parent link="front_sensor_mount_link"/>
    <child link="front_rgb_camera_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </joint>

  <link name="front_rgb_camera_optical_frame"/>

  <joint name="front_rgb_optical_joint" type="fixed">
    <parent link="front_rgb_camera_link"/>
    <child link="front_rgb_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="front_depth_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="camera_dark">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="front_depth_camera_joint" type="fixed">
    <parent link="front_sensor_mount_link"/>
    <child link="front_depth_camera_link"/>
    <origin xyz="0 0 -0.015" rpy="0 0 0"/>
  </joint>

  <link name="front_depth_camera_optical_frame"/>

  <joint name="front_depth_optical_joint" type="fixed">
    <parent link="front_depth_camera_link"/>
    <child link="front_depth_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="top_lidar_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="5e-05" ixy="0.0" ixz="0.0" iyy="5e-05" iyz="0.0" izz="5e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="top_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_lidar_link"/>
    <origin xyz="${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>

  <link name="top_lidar_frame"/>

  <joint name="top_lidar_frame_joint" type="fixed">
    <parent link="top_lidar_link"/>
    <child link="top_lidar_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="mid_360_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="5e-05" ixy="0.0" ixz="0.0" iyy="5e-05" iyz="0.0" izz="5e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="mid_360_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid_360_link"/>
    <origin xyz="0.12 0 0.0537" rpy="0 0.5236 0"/>
  </joint>

  <link name="mid_360_frame"/>

  <joint name="mid_360_frame_joint" type="fixed">
    <parent link="mid_360_link"/>
    <child link="mid_360_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="RGLLidar"/>

  <joint name="RGLLidar_joint" type="fixed">
    <parent link="mid_360_link"/>
    <child link="RGLLidar"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
