    <!-- MID360 lidar on the front mounting plate, tilted 61 deg downward.
         Blender plate position was (0, 0.2, -0.25); body visual was rotated
         -90 deg CW around Z, so the plate is now physically at SDF
         (0.2, 0, -0.25). Pitch = 1.0647 rad (= 61 deg) around Y. -->
    <include merge='true'>
      <pose relative_to="base_link">0.23 0 -0.25 0 1.0647 0</pose>
      <uri>model://mid_360</uri>
    </include>

    <joint name="mid_360_joint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

  </model>
</sdf>
