<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="intel_realsense">
    <link name="realsense_link">
      <inertial>
        <mass>0.0615</mass>
        <inertia>
          <ixx>9.108e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.51e-06</iyy>
          <iyz>0</iyz>
          <izz>8.931e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
     <!-- RGB Camera (D435i: 69° x 42° FOV, 1920x1080 max, hier 640x480 für Simulation) -->
     <sensor name="realsense_rgb" type="camera">
        <pose>0.02 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <topic>/marvin_drohne_alles/front_rgb/image</topic>
        <frame_id>front_rgb_camera_optical_frame</frame_id>
        <gz_frame_id>front_rgb_camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
    </sensor>

    <!-- Depth Camera (D435i: 87° x 58° FOV, 1280x720 max, 0.105–10m Reichweite) -->
    <sensor name="realsense_depth" type="depth_camera">
        <pose>0.02 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <topic>/marvin_drohne_alles/front_depth/image</topic>
        <frame_id>front_depth_camera_optical_frame</frame_id>
        <gz_frame_id>front_depth_camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.105</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <visualize>true</visualize>
    </sensor>
    </link>
  </model>
</sdf>
