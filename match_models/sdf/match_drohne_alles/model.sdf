    <joint name="top_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>top_lidar_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint> -->

        <frame name="front_rgb_camera_frame" attached_to="front_sensor_mount_link">
      <!-- kleine Offsets möglich, wenn die Kamera nicht genau im Link-Zentrum sitzt -->
      <pose>0 0 0 0 0 0</pose>
    </frame>

    <frame name="front_depth_camera_frame" attached_to="front_sensor_mount_link">
      <pose>0 0 0 0 0 0</pose>
    </frame>

     <!-- <frame name="top_lidar_frame" attached_to="top_lidar_link">
      <pose>0 0 0 0 0 0</pose>
    </frame>  -->

  </model>
</sdf>
